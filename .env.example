# SŪTRA Configuration

# ----------------------------------------------------------------------------
# SERVER & WORKSPACE CONFIGURATION
# ----------------------------------------------------------------------------
# Host binding for local supervisor (must be 127.0.0.1 for local-first security)
HOST=127.0.0.1
PORT=8000

# Path to the target codebase being supervised
WORKSPACE_ROOT=.

# SQLite database file path (WAL mode automatically enabled)
DATABASE_PATH=sutra_audit.db

# Dev CORS settings (allow dashboard Vite origin only)
CORS_ORIGIN=http://localhost:5173

# ----------------------------------------------------------------------------
# TELEGRAM BOT SUPERVISION (Optional, long-polling only, no inbound ports)
# ----------------------------------------------------------------------------
# Obtain via @BotFather on Telegram. If unset, SŪTRA runs with ConsoleChannel.
BOT_TOKEN=

# ----------------------------------------------------------------------------
# OLLAMA / LOCAL LLM ADVISORY (Optional, advisory only, never executes)
# ----------------------------------------------------------------------------
# URL to local Ollama instance
OLLAMA_URL=http://localhost:11434

# Advisory model tag (e.g., gemma3:4b, gemma2:2b, etc.)
OLLAMA_MODEL=gemma3:4b
